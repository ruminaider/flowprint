{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://flowprint.dev/schema/flowprint-rules-test/1.0",
  "title": "Flowprint Rules Test File",
  "type": "object",
  "required": ["schema", "tests"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^flowprint-rules-test/\\d+\\.\\d+$"
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "input"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "input": { "type": "object" },
          "expected_output": { "type": "object" },
          "expected_matched_count": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
