{
  "name": "flowprint",
  "version": "0.0.0",
  "description": "CLI for validating, linting, and diffing Flowprint service blueprints",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "flowprint": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.2.0",
    "@ruminaider/flowprint-engine": "workspace:*",
    "@ruminaider/flowprint-schema": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "glob": "^13.0.1",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.25.3",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^25.2.2",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "license": "MIT"
}
